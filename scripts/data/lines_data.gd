extends RefCounted
## Режим «Война линий» (по мотивам Hero Line Wars): числа баланса режима.
## Всё здесь касается только «Линий» — осада эти константы не читает (её баланс не меняется).
## Отправки врагов — sends.gd, логика — scripts/modes/lines_mode.gd, карта — tools/bake_map_lines.gd.
## Числа подобраны симуляцией tools/lines_sim.gd (таблица — в отчёте 12).

const MODE_NAME := "Война линий"

## Команды: 0 — юг (база на юге, линии на западной половине), 1 — север (база на севере, восточная половина).
const TEAMS := [
	{"name": "Юг", "full": "Южная твердыня", "color": Color(0.35, 0.6, 1.0)},
	{"name": "Север", "full": "Северная твердыня", "color": Color(1.0, 0.4, 0.3)},
]
const MAX_LANES := 3                # линий на сторону (по числу игроков большей команды)

# ---------------------------------------------------------------- база
## 5000 в первой проверке: партия ботов 1×1 к 10-й минуте опускала базы до 1000 (лейтенант 12-й волны и отправки
## 3-й ступени), дальше их держал «последний рубеж». 8000 — чтобы середина партии шла дольше (цель 20–35 мин.).
const BASE_HP := 8000.0
const BASE_RADIUS := 6.5
## Башни базы: бьют врагов у базы (линия без игрока тоже «работает», но база не беззащитна).
## «Последний рубеж» — при здоровье базы ниже доли below башни злее и бьют дальше (данные, не код).
const TOWERS := {
	"normal": {"radius": 18.0, "every": 1.4, "shots": 1, "min": 30.0, "max": 40.0, "grow": 0.12},
	"last_stand": {"below": 0.25, "radius": 26.0, "every": 0.8, "shots": 3, "min": 45.0, "max": 60.0, "grow": 0.15},
}

# ---------------------------------------------------------------- время и общие волны
const FIRST_WAVE_DELAY := 20.0
const WAVE_EVERY := 30.0            # общие волны — всем линиям одновременно
## Сила общих волн растёт со временем: «волна для расчёта силы» = 1 + минута × WAVE_PER_MIN
## (те же формулы здоровья и урона, что в осаде: formulas.mob_hp_mult / mob_dmg_mult).
const WAVE_PER_MIN := 0.62
## Бюджет общей волны на линию — доля бюджета волны осады той же силы (волны идут чаще).
const WAVE_BUDGET_K := 0.55
## Линия без игрока получает общие волны слабее.
const EMPTY_LANE_K := 0.5
## Элитные в общих волнах (одинаковые для всех линий — честно): шанс как в осаде, по силе волны.
## Босс-волны: каждая CHAMPION_EVERY-я — чемпион, LIEUTENANT_EVERY-я — лейтенант, MAIN_EVERY-я — главный босс.
const CHAMPION_EVERY := 6
const LIEUTENANT_EVERY := 12
const MAIN_EVERY := 24
## Здоровье боссов общих волн (на линии один герой, а не отряд).
const BOSS_HP_K := 0.55

## Цель — партия на 20–35 минут. С 40-й минуты — «внезапная смерть»: общие волны резко сильнее,
## на 50-й побеждает база с большим запасом здоровья.
const SUDDEN_DEATH_MIN := 40.0
const SUDDEN_BUDGET_K := 2.0        # бюджет общих волн ×2
const SUDDEN_HP_PER_MIN := 0.2      # и здоровье +20% за каждую минуту после 40-й
const HARD_END_MIN := 50.0

# ---------------------------------------------------------------- экономика
const INCOME_EVERY := 15.0
const BASE_INCOME := 12             # золота каждые 15 сек. каждому игроку
const INCOME_PER_MIN := 0.6         # базовый доход немного растёт со временем (+0,6 за минуту)
## Против снежного кома: отстающая по здоровью базы команда получает +CATCHUP × разница
## (например, разница 30% здоровья баз → +30% дохода).
const CATCHUP := 1.0
## Меньшая команда: +SMALL_TEAM за каждого недостающего игрока.
const SMALL_TEAM := 0.5
## Золото за убийство общих врагов — ×KILL_GOLD_K к осадному; за отправленного врага — доля цены.
const KILL_GOLD_K := 2.0
const SEND_BOUNTY := 0.35
## Опыт за убийство ×XP_K: врагов на линии меньше, чем на полосах осады, — без множителя герой к 30-й минуте
## был бы 16-го уровня при силе волн 19 (симуляция). С ×2 — около 23-го, как в осаде (уровень ≈ 1,2 × волна).
const XP_K := 2.0
## Стартовое золото.
const START_GOLD := 100

# ---------------------------------------------------------------- добыча (решение пользователя)
## Общие волны роняют вещи вдвое реже, чем в осаде; отправленные враги вещей не роняют
## (только золото и зелья); боссы общих волн — как в осаде.
const GEAR_K := 0.5
const SENT_GEAR_K := 0.0
## Лавка кузнеца в «Линиях»: синие вещи в каждой ротации, 2–3 штуки (в осаде — в 60% ротаций, 1–2).
const SHOP_BLUE := {"chance": 1.0, "min": 2, "extra": 0.5}

# ---------------------------------------------------------------- смерть
## Воскрешение — как в осаде (растёт с уровнем). Выкуп: воскреснуть сразу за золото.
const BUYBACK_BASE := 40
const BUYBACK_PER_LEVEL := 12

# ---------------------------------------------------------------- боты («Добавить бота в команду», --teams=)
const BOT_NAMES := ["Бот Ратибор", "Бот Всеслава", "Бот Добрыня", "Бот Ярина", "Бот Святогор", "Бот Милена"]
## Классы ботов-игроков (охотник без питомца сильно слабее — бот питомцем на сервере не управляет).
const BOT_CLASSES := ["warrior", "paladin", "mage", "priest", "shaman", "rogue"]
## Простая стратегия бота: часть золота — в отправки, остальное — в вещи.
const BOT_SEND_SHARE := 0.5
const BOT_SHOP_EVERY := 45.0        # раз в столько секунд бот идёт на базу за покупками

static func wave_strength(minute: float) -> float:
	return 1.0 + minute * WAVE_PER_MIN

static func base_income(minute: float) -> int:
	return BASE_INCOME + int(minute * INCOME_PER_MIN)

static func buyback_price(level: int) -> int:
	return BUYBACK_BASE + BUYBACK_PER_LEVEL * level
