; Engine configuration file.
; Hero Siege — кооперативная защита замка в духе WC3 Hero Siege с видом как в WoW.

config_version=5

[application]

config/name="Hero Siege"
config/description="Кооперативная RPG-защита замка: маги, паладины, жрецы против волн нежити."
config/version="0.14.3"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=144

[autoload]

GameData="*res://scripts/data/game_data.gd"
Net="*res://scripts/net/network.gd"
Settings="*res://scripts/core/settings.gd"
Sfx="*res://scripts/core/sfx.gd"
Keys="*res://scripts/core/keybinds.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/custom_font=null

